# Local deployment only. Copy to .env and adjust if needed.

# Airflow
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me
# Generate with: scripts/generate_fernet_key.sh   (required; docker compose refuses to start without it)
AIRFLOW__CORE__FERNET_KEY=

# Postgres (Airflow + MLflow)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me

# MinIO (MLflow artifacts)
MINIO_USERNAME=change-me
MINIO_PASSWORD=change-me
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me

# Fraud API (data source for training & inference)
FRAUD_API_URL=https://3consult-ng.com/fraud_api.php
FRAUD_API_MAX_RECORDS=100000

# Inference
INFERENCE_PORT=8000
INFERENCE_SERVICE_URL=http://inference:8000
MLFLOW_TRACKING_URI=http://mlflow-server:5500
AIRFLOW_WEBSERVER_URL=http://airflow-webserver:8080

# Moniguard
FLASK_DEBUG=False

# Flask session signing key, at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Local development only: true generates a random per-process SECRET_KEY. Never use in deployment.
MONIGUARD_DEV_MODE=false
# Set true when the dashboard is served over HTTPS.
MONIGUARD_SECURE_COOKIES=false
# Dashboard demo-account passwords (plaintext or a hash from: flask --app moniguard/app.py hash-password).
# An account whose password is empty is disabled. Single-quote hashes in .env files.
MONIGUARD_ADMIN_PASSWORD=
MONIGUARD_EXEC_PASSWORD=
MONIGUARD_OPS_PASSWORD=
MONIGUARD_ANALYST_PASSWORD=
# Scoring API keys, comma-separated (plaintext or sha256 hex). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Empty means the scoring API refuses every request (503).
MONIGUARD_API_KEYS=

# Transactions Database (Producer, Training, Inference)
POSTGRES_TRANSACTIONS_DB=transactions_db
POSTGRES_TRANSACTIONS_USER=fraud_producer
POSTGRES_TRANSACTIONS_PASSWORD=change-me

# MLflow Database
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=change-me
MLFLOW_DB_NAME=mlflow

# Training (optional)
XGB_N_JOBS=1

# Optional: Flower (Celery UI). Start with: docker compose --profile flower up -d
# Flower: http://localhost:5555
# MinIO Console: http://localhost:9001 | MinIO API: http://localhost:9000





