# Local deployment only.

# Airflow
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Postgres (Airflow + MLflow)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow

# MinIO (MLflow artifacts)
MINIO_USERNAME=minioadmin
MINIO_PASSWORD=minioadmin
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Fraud API (training & inference data source)
FRAUD_API_URL=https://3consult-ng.com/fraud_api.php
FRAUD_API_MAX_RECORDS=100000

# Inference & moniguard
INFERENCE_PORT=8000
INFERENCE_SERVICE_URL=http://inference:8000
MLFLOW_TRACKING_URI=http://mlflow-server:5500
AIRFLOW_WEBSERVER_URL=http://airflow-webserver:8080
FLASK_DEBUG=False

# Transactions Database (Producer, Training, Inference)
# Note: Producer uses fraud_producer, Training/Airflow use fraud_training
POSTGRES_TRANSACTIONS_DB=transactions_db
POSTGRES_TRANSACTIONS_USER=fraud_producer
POSTGRES_TRANSACTIONS_PASSWORD=producer_password

# MLflow Database
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow
MLFLOW_DB_NAME=mlflow

# Training (optional)
XGB_N_JOBS=1




