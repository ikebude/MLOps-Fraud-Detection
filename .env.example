# Local Development Environment Configuration
# Copy this to .env in the project root and customize for your environment

# ========== DATABASE CONFIGURATION ==========
# ISOLATED DATABASE SETUP:
# - transactions_db: Producer writes, Inference/Training/Airflow read
# - mlflow: MLflow experiment tracking
# - airflow: Airflow DAG metadata

# PostgreSQL Host (shared by all services)
DB_HOST=127.0.0.1
DB_PORT=5432

# ========== PRODUCER DATABASE (transactions_db) ==========
# Producer: Writes new transactions to transactions_db
DB_NAME=transactions_db
DB_USER=fraud_producer
DB_PASSWORD=producer_password

# ========== INFERENCE DATABASE (transactions_db read-only) ==========
# Inference script reads from same transactions_db
INFERENCE_DB_HOST=127.0.0.1
INFERENCE_DB_PORT=5432
INFERENCE_DB_NAME=transactions_db
INFERENCE_DB_USER=fraud_inference
INFERENCE_DB_PASSWORD=inference_password

# ========== TRAINING DATABASE (transactions_db read-only) ==========
# Training script reads raw transactions from transactions_db
TRAINING_DB_HOST=127.0.0.1
TRAINING_DB_PORT=5432
TRAINING_DB_NAME=transactions_db
TRAINING_DB_USER=fraud_training
TRAINING_DB_PASSWORD=training_password

# PostgreSQL SSL Mode (prefer, require, disable)
DB_SSLMODE=prefer

# ========== PRODUCER CONFIGURATION ==========
# Time between transaction batches (seconds)
PRODUCER_INTERVAL=0.5

# Number of transactions per batch
PRODUCER_BATCH_SIZE=1

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ========== INFERENCE CONFIGURATION ==========
# Path to trained fraud detection model
MODEL_PATH=/app/models/fraud_detection_model.pkl

# ========== MLFLOW CONFIGURATION ==========
# MLflow tracking server URI
MLFLOW_TRACKING_URI=http://localhost:5500

# MinIO S3 endpoint for MLflow artifacts
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# AWS credentials for MinIO
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ========== AIRFLOW CONFIGURATION ==========
# These are used by docker-compose services
# Airflow-specific database (separate from transactions_db)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow

# ========== API CONFIGURATION ==========
# External fraud API endpoint (if used)
FRAUD_API_URL=https://3consult-ng.com/fraud_api.php

# Maximum records to fetch from fraud API per run
FRAUD_API_MAX_RECORDS=100000

# ========== DEVELOPMENT FLAGS ==========
# Set to true to skip some validations (dev only)
DEV_MODE=false

# Database connection timeout (seconds)
DB_CONNECT_TIMEOUT=10

# Maximum number of retries before giving up
MAX_RETRIES=5


