# Local Development Environment Configuration
# Copy this to .env in the project root and customize for your environment

# ========== DATABASE CONFIGURATION ==========
# ISOLATED DATABASE SETUP:
# - transactions_db: Producer writes, Inference/Training/Airflow read
# - mlflow: MLflow experiment tracking
# - airflow: Airflow DAG metadata

# PostgreSQL Host (shared by all services)
DB_HOST=127.0.0.1
DB_PORT=5432

# ========== PRODUCER DATABASE (transactions_db) ==========
# Producer: Writes new transactions to transactions_db
DB_NAME=transactions_db
DB_USER=fraud_producer
DB_PASSWORD=change-me

# ========== INFERENCE DATABASE (transactions_db read-only) ==========
# Inference script reads from same transactions_db
INFERENCE_DB_HOST=127.0.0.1
INFERENCE_DB_PORT=5432
INFERENCE_DB_NAME=transactions_db
INFERENCE_DB_USER=fraud_inference
INFERENCE_DB_PASSWORD=change-me

# ========== TRAINING DATABASE (transactions_db read-only) ==========
# Training script reads raw transactions from transactions_db
TRAINING_DB_HOST=127.0.0.1
TRAINING_DB_PORT=5432
TRAINING_DB_NAME=transactions_db
TRAINING_DB_USER=fraud_training
TRAINING_DB_PASSWORD=change-me

# PostgreSQL SSL Mode (prefer, require, disable)
DB_SSLMODE=prefer

# ========== PRODUCER CONFIGURATION ==========
# Time between transaction batches (seconds)
PRODUCER_INTERVAL=0.5

# Number of transactions per batch
PRODUCER_BATCH_SIZE=1

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ========== INFERENCE CONFIGURATION ==========
# Path to trained fraud detection model
MODEL_PATH=/app/models/fraud_detection_model.pkl

# ========== MLFLOW CONFIGURATION ==========
# MLflow tracking server URI
MLFLOW_TRACKING_URI=http://localhost:5500

# MinIO S3 endpoint for MLflow artifacts
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# AWS credentials for MinIO
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me

# ========== AIRFLOW CONFIGURATION ==========
# These are used by docker-compose services
# Airflow-specific database (separate from transactions_db)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me

# ========== API CONFIGURATION ==========
# Optional external transaction feed. Leave empty to use the built-in generator.
FRAUD_API_URL=

# Maximum records to fetch from fraud API per run
FRAUD_API_MAX_RECORDS=100000

# ========== DEVELOPMENT FLAGS ==========
# Set to true to skip some validations (dev only)
DEV_MODE=false

# Database connection timeout (seconds)
DB_CONNECT_TIMEOUT=10

# Maximum number of retries before giving up
MAX_RETRIES=5








# ========== DOCKER COMPOSE / AIRFLOW (mirrors src/.env.example) ==========
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me
# Generate with: scripts/generate_fernet_key.sh   (required; leave empty here, never commit a value)
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW_WEBSERVER_URL=http://airflow-webserver:8080

# Transactions database (producer / training / inference)
POSTGRES_TRANSACTIONS_DB=transactions_db
POSTGRES_TRANSACTIONS_USER=fraud_producer
POSTGRES_TRANSACTIONS_PASSWORD=change-me

# MLflow
MLFLOW_REGISTERED_MODEL=fraud_detection_model
MLFLOW_DB_NAME=mlflow
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=change-me

# MinIO
MINIO_USERNAME=change-me
MINIO_PASSWORD=change-me
MINIO_URL=http://minio:9000
FLOWER_URL=http://flower:5555

# Inference service
INFERENCE_PORT=8000
INFERENCE_SERVICE_URL=http://inference:8000
CONTINUOUS_INFERENCE_INTERVAL=0.2
INFERENCE_RESULTS_HISTORY_MAX=10000

# Training
XGB_N_JOBS=1

# Flask / Moniguard dashboard
FLASK_DEBUG=False
FLASK_APP=app.py
FLASK_PORT=5000
MONIGUARD_REQUEST_TIMEOUT=10

# ========== MONIGUARD DASHBOARD AND SCORING API (required secrets) ==========
# Flask session signing key, at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Local development only: true generates a random per-process SECRET_KEY. Never use in deployment.
MONIGUARD_DEV_MODE=false
# Set true when the dashboard is served over HTTPS.
MONIGUARD_SECURE_COOKIES=false
# Dashboard demo-account passwords (plaintext or a hash from: flask --app moniguard/app.py hash-password).
# An account whose password is empty is disabled. Single-quote hashes in .env files.
MONIGUARD_ADMIN_PASSWORD=
MONIGUARD_EXEC_PASSWORD=
MONIGUARD_OPS_PASSWORD=
MONIGUARD_ANALYST_PASSWORD=
# Scoring API keys, comma-separated (plaintext or sha256 hex). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Empty means the scoring API refuses every request (503).
MONIGUARD_API_KEYS=
